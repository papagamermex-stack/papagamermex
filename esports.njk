---
layout: base.njk
title: Esports - Papá Gamer Mex
pagination:
  data: collections.esports
  size: 12
  alias: posts
  reverse: true
permalink: "esports/{% if pagination.pageNumber > 0 %}{{ pagination.pageNumber + 1 }}/{% endif %}index.html"
---

<section style="padding: 6rem 2rem 4rem; max-width: 1200px; margin: 0 auto; min-height: 70vh;">
  <div class="sec-head">
    <h1 class="sec-title">Esports</h1>
  </div>
  
  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1.5rem; margin-bottom: 3rem;">
    {% for post in posts %}
      <a href="{{ post.url }}" class="card">
        <div class="card-img" style="aspect-ratio: 16/9;">
          <img src="{{ post.data.image if post.data.image else 'https://images.unsplash.com/photo-1542751371-adc38448a05e?w=800&q=80' }}" alt="{{ post.data.title }}">
          <span class="cat-tag tag-purple">{{ post.data.category | default("ESPORTS") | upper }}</span>
        </div>
        <div class="card-body">
          <h3 class="card-title" style="font-size: 1.1rem; margin-bottom: 0.5rem;">{{ post.data.title }}</h3>
          <div class="card-meta">
            <span>🕐 {{ post.date | date }}</span>
          </div>
        </div>
      </a>
    {% endfor %}
  </div>

  <div style="display: flex; gap: 1rem; justify-content: center;">
    {% if pagination.href.previous %}
      <a href="{{ pagination.href.previous }}" class="btn-ghost">← Más recientes</a>
    {% endif %}
    {% if pagination.href.next %}
      <a href="{{ pagination.href.next }}" class="btn-cyan">Más antiguas →</a>
    {% endif %}
  </div>
</section>
